<UserControl x:Class="LlrpReaderStudio.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LlrpReaderStudio.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}">
    <Grid Background="#0F172A">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Circular Play/Stop Toggle -->
                <Button Grid.Column="0" Command="{Binding ToggleInventoryCommand}" Width="48" Height="48" Background="Transparent" BorderThickness="0" ToolTip="Start / Stop LLRP Reader Inventory" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="bg" Fill="#10B981" />
                                <TextBlock x:Name="icon" Text="▶" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInventoryRunning}" Value="True">
                                    <Setter TargetName="bg" Property="Fill" Value="#EF4444" />
                                    <Setter TargetName="icon" Property="Text" Value="◼" />
                                    <Setter TargetName="icon" Property="Margin" Value="0" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Center Digital Timer Display -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="ELAPSED TIME: " Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ElapsedTimeText}" FontSize="36" FontFamily="Consolas, Courier New" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Quick Clear Tags -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Clear Tags" Command="{Binding ClearTagsCommand}" Style="{StaticResource WorkbenchButtonStyle}" Padding="14,6" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- High Contrast DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" AlternatingRowBackground="#1E293B" Background="#0F172A"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                  RowHeight="32" FontSize="12" Foreground="#F8FAFC" Margin="16" BorderBrush="#334155" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0F172A" />
                    <Setter Property="Foreground" Value="#38BDF8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="BorderBrush" Value="#334155" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#0284C7" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" />
                <DataGridTextColumn Header="EPC" Binding="{Binding Epc}" Width="2.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Courier New" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#F8FAFC" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="TID" Binding="{Binding Tid}" Width="1.8*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas, Courier New" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Count" Binding="{Binding SeenCount}" Width="80" />
                <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeenTimeText}" Width="110" />
                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenTimeText}" Width="110" />
                <DataGridTextColumn Header="Reader" Binding="{Binding ReaderName}" Width="120" />
                <DataGridTextColumn Header="Antenna" Binding="{Binding AntennaId}" Width="70" />
                <DataGridTextColumn Header="Peak RSSI" Binding="{Binding PeakRssiText}" Width="90" />
                <DataGridTextColumn Header="Channel" Binding="{Binding ChannelIndexText}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

<UserControl x:Class="LlrpReaderStudio.Views.DataSourceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LlrpReaderStudio.ViewModels"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1280"
             d:DataContext="{d:DesignInstance Type=vm:DataSourceSettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>

        <Style x:Key="FieldControlStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Hostname:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SelectedReaderHost}" Margin="0,0,18,0" />
                    <TextBlock Text="Interface:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="LLRP" Margin="0,0,18,0" />
                    <TextBlock Text="Model:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SelectedReaderModel}" Margin="0,0,18,0" />
                    <TextBlock Text="Region:" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SelectedReaderRegion}" />
                </WrapPanel>
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="REFRESH SETTINGS" Command="{Binding QuerySettingsCommand}" Margin="4,0,0,0" />
                <Button Content="LOAD DEFAULTS" Command="{Binding DefaultSettingsCommand}" Margin="4,0,0,0" />
            </WrapPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0" MinHeight="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="SAVE" Command="{Binding ApplySettingsCommand}" Width="180" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="CANCEL" Command="{Binding CancelCommand}" Width="180" Margin="0,0,12,0" />
            <TextBox Grid.Column="2" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="5,0,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
        </Grid>

        <TabControl>
            <TabItem Header="Inventory">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Text="{Binding Preset}" IsEditable="True" Width="260">
                                <ComboBoxItem Content="Default" />
                            </ComboBox>
                            <TextBlock Text="{Binding SettingsOrigin}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                        <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Text="MANUAL SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Antennas:" Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="ALL" Width="60" Margin="0,0,6,0" Command="{Binding FillAllAntennasCommand}" />
                                    <Button Content="CLEAR" Width="70" Command="{Binding ClearAntennasCommand}" />
                                </StackPanel>
                                <TextBox Text="{Binding Antennas, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="RF Mode:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RfModeOptions}" Text="{Binding RfMode}" IsEditable="True" Style="{StaticResource FieldControlStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Search Mode:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Text="{Binding SearchMode}" IsEditable="True" IsEnabled="{Binding ImpinjExtensionsAvailable}" Style="{StaticResource FieldControlStyle}">
                                <ComboBoxItem Content="Reader Selected" />
                                <ComboBoxItem Content="Single Target" />
                                <ComboBoxItem Content="Dual Target" />
                                <ComboBoxItem Content="TagFocus" />
                                <ComboBoxItem Content="No Target" />
                                <ComboBoxItem Content="Single Target Reset" />
                                <ComboBoxItem Content="Dual Target Select B to A" />
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Enable Fast ID:" Style="{StaticResource FieldLabelStyle}" />
                            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding EnableFastId}" IsEnabled="{Binding ImpinjExtensionsAvailable}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Estimated Tag Population:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Population}" Style="{StaticResource FieldControlStyle}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Session:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="5" Grid.Column="1" Text="{Binding Session}" IsEditable="True" Style="{StaticResource FieldControlStyle}">
                                <ComboBoxItem Content="Session 0" />
                                <ComboBoxItem Content="Session 1" />
                                <ComboBoxItem Content="Session 2" />
                                <ComboBoxItem Content="Session 3" />
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Report Phase Angle:" Style="{StaticResource FieldLabelStyle}" />
                            <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding ReportPhaseAngle}" IsEnabled="{Binding ImpinjExtensionsAvailable}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Report Doppler Frequency:" Style="{StaticResource FieldLabelStyle}" />
                            <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding ReportDopplerFrequency}" IsEnabled="{Binding ImpinjExtensionsAvailable}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Text="POWER AND SENSITIVITY SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <Grid DockPanel.Dock="Top" Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tx Power Index:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TxPowerOptions}" Text="{Binding PowerDbm}" IsEditable="True" IsEnabled="{Binding IsGlobalAntennaSettingsEnabled}" Style="{StaticResource FieldControlStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rx Sensitivity:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RxSensitivityOptions}" Text="{Binding RxSensitivity}" IsEditable="True" IsEnabled="{Binding IsGlobalAntennaSettingsEnabled}" Style="{StaticResource FieldControlStyle}" />
                            </Grid>

                            <Expander DockPanel.Dock="Top" IsExpanded="{Binding IsIndividualAntennasExpanded, Mode=TwoWay}" Margin="8,0,8,8">
                                <Expander.Header>
                                    <Border Style="{StaticResource SectionHeaderStyle}" MinWidth="280">
                                        <TextBlock Text="INDIVIDUAL ANTENNAS" Style="{StaticResource SectionHeaderTextStyle}" />
                                    </Border>
                                </Expander.Header>
                                <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding AntennaSettings}" Margin="8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AntennaSettingsRow}">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Tx Power Index:" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="2"
                                                              ItemsSource="{Binding DataContext.TxPowerOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              Text="{Binding TxPower}"
                                                              IsEditable="True"
                                                              Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="3" Text="Rx Sensitivity:" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="4"
                                                              ItemsSource="{Binding DataContext.RxSensitivityOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              Text="{Binding RxSensitivity}"
                                                              IsEditable="True" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Expander>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Text="GPI CONFIGURATION" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <DataGrid ItemsSource="{Binding GpiSettings}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False"
                                      HeadersVisibility="Column"
                                      Height="160"
                                      Margin="8"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                                      RowHeight="32"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                      AlternatingRowBackground="{DynamicResource MahApps.Brushes.Gray10}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Header="START" Binding="{Binding StartEnabled}" Width="65">
                                        <DataGridCheckBoxColumn.ElementStyle>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox.DataGrid}">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridCheckBoxColumn.ElementStyle>
                                    </DataGridCheckBoxColumn>
                                    <DataGridTextColumn Header="LEVEL" Binding="{Binding StartLevel}" Width="65">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Header="STOP" Binding="{Binding StopEnabled}" Width="65">
                                        <DataGridCheckBoxColumn.ElementStyle>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox.DataGrid}">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridCheckBoxColumn.ElementStyle>
                                    </DataGridCheckBoxColumn>
                                    <DataGridTextColumn Header="LEVEL" Binding="{Binding StopLevel}" Width="65">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="DEBOUNCE (ms)" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding DebounceMs}" 
                                                         IsEnabled="{Binding IsDebounceEnabled}" 
                                                         VerticalAlignment="Center" 
                                                         Margin="2"
                                                         HorizontalContentAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <Border Style="{StaticResource SectionBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Text="GEN 2 FILTERING" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Filter1Enabled}" Content="Filter 1" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding Filter2Enabled}" Content="Filter 2" HorizontalAlignment="Center" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Filter1}" Margin="0,0,6,6" />
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Filter2}" Margin="6,0,0,6" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bit Length:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Filter1BitLength}" Margin="0,0,6,6" />
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Filter2BitLength}" Margin="6,0,0,6" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Offset:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Filter1Offset}" Margin="0,0,6,6" />
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Filter2Offset}" Margin="6,0,0,6" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Memory Bank:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Text="{Binding Filter1MemoryBank}" IsEditable="True" Margin="0,0,6,6">
                                <ComboBoxItem Content="EPC" />
                                <ComboBoxItem Content="TID" />
                                <ComboBoxItem Content="User" />
                                <ComboBoxItem Content="Reserved" />
                            </ComboBox>
                            <ComboBox Grid.Row="4" Grid.Column="2" Text="{Binding Filter2MemoryBank}" IsEditable="True" Margin="6,0,0,6">
                                <ComboBoxItem Content="EPC" />
                                <ComboBoxItem Content="TID" />
                                <ComboBoxItem Content="User" />
                                <ComboBoxItem Content="Reserved" />
                            </ComboBox>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="State-Aware:" Style="{StaticResource FieldLabelStyle}" Visibility="{Binding SupportsStateAwareFiltersVisibility}" />
                            <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding EnableStateAwareFilters}" VerticalAlignment="Center" Visibility="{Binding SupportsStateAwareFiltersVisibility}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Target:" Style="{StaticResource FieldLabelStyle}" Visibility="{Binding EnableStateAwareFiltersVisibility}" />
                            <ComboBox Grid.Row="6" Grid.Column="1" Text="{Binding Filter1Target}" IsEditable="True" Margin="0,0,6,6" Visibility="{Binding EnableStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Selected Flag" />
                                <ComboBoxItem Content="Session0" />
                                <ComboBoxItem Content="Session1" />
                                <ComboBoxItem Content="Session2" />
                                <ComboBoxItem Content="Session3" />
                            </ComboBox>
                            <ComboBox Grid.Row="6" Grid.Column="2" Text="{Binding Filter2Target}" IsEditable="True" Margin="6,0,0,6" Visibility="{Binding EnableStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Selected Flag" />
                                <ComboBoxItem Content="Session0" />
                                <ComboBoxItem Content="Session1" />
                                <ComboBoxItem Content="Session2" />
                                <ComboBoxItem Content="Session3" />
                            </ComboBox>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Action:" Style="{StaticResource FieldLabelStyle}" Visibility="{Binding EnableStateAwareFiltersVisibility}" />
                            <ComboBox Grid.Row="7" Grid.Column="1" Text="{Binding Filter1Action}" IsEditable="True" Margin="0,0,6,6" Visibility="{Binding EnableStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Assert A/Deassert B" />
                                <ComboBoxItem Content="Assert A/No Op" />
                                <ComboBoxItem Content="No Op/Deassert B" />
                                <ComboBoxItem Content="Negate/No Op" />
                                <ComboBoxItem Content="Deassert B/Assert A" />
                                <ComboBoxItem Content="Deassert B/No Op" />
                                <ComboBoxItem Content="No Op/Assert A" />
                                <ComboBoxItem Content="No Op/Negate" />
                            </ComboBox>
                            <ComboBox Grid.Row="7" Grid.Column="2" Text="{Binding Filter2Action}" IsEditable="True" Margin="6,0,0,6" Visibility="{Binding EnableStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Assert A/Deassert B" />
                                <ComboBoxItem Content="Assert A/No Op" />
                                <ComboBoxItem Content="No Op/Deassert B" />
                                <ComboBoxItem Content="Negate/No Op" />
                                <ComboBoxItem Content="Deassert B/Assert A" />
                                <ComboBoxItem Content="Deassert B/No Op" />
                                <ComboBoxItem Content="No Op/Assert A" />
                                <ComboBoxItem Content="No Op/Negate" />
                            </ComboBox>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Match Action:" Style="{StaticResource FieldLabelStyle}" Visibility="{Binding NonStateAwareFiltersVisibility}" />
                            <ComboBox Grid.Row="8" Grid.Column="1" Text="{Binding Filter1MatchAction}" IsEditable="True" Margin="0,0,6,6" Visibility="{Binding NonStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Select" />
                                <ComboBoxItem Content="Unselect" />
                                <ComboBoxItem Content="Do Nothing" />
                            </ComboBox>
                            <ComboBox Grid.Row="8" Grid.Column="2" Text="{Binding Filter2MatchAction}" IsEditable="True" Margin="6,0,0,6" Visibility="{Binding NonStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Select" />
                                <ComboBoxItem Content="Unselect" />
                                <ComboBoxItem Content="Do Nothing" />
                            </ComboBox>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Non-Match Action:" Style="{StaticResource FieldLabelStyle}" Visibility="{Binding NonStateAwareFiltersVisibility}" />
                            <ComboBox Grid.Row="9" Grid.Column="1" Text="{Binding Filter1NonMatchAction}" IsEditable="True" Margin="0,0,6,6" Visibility="{Binding NonStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Select" />
                                <ComboBoxItem Content="Unselect" />
                                <ComboBoxItem Content="Do Nothing" />
                            </ComboBox>
                            <ComboBox Grid.Row="9" Grid.Column="2" Text="{Binding Filter2NonMatchAction}" IsEditable="True" Margin="6,0,0,6" Visibility="{Binding NonStateAwareFiltersVisibility}">
                                <ComboBoxItem Content="Select" />
                                <ComboBoxItem Content="Unselect" />
                                <ComboBoxItem Content="Do Nothing" />
                            </ComboBox>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Text="FREQUENCY SETTINGS" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Text="Use Specified Frequencies:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Column="1" Text="{Binding UseSpecifiedFrequencies}" IsEditable="False" IsEnabled="{Binding ImpinjExtensionsAvailable}" Style="{StaticResource FieldControlStyle}">
                                <ComboBoxItem Content="Disabled" />
                                <ComboBoxItem Content="Auto Select" />
                                <ComboBoxItem Content="Channel List" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Channels:" Style="{StaticResource FieldLabelStyle}" Visibility="{Binding FrequencyChannelsVisibility}" />
                            <ScrollViewer Grid.Row="1" Grid.Column="1"
                                          MaxHeight="150"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,0,6"
                                          Visibility="{Binding FrequencyChannelsVisibility}">
                                <ItemsControl ItemsSource="{Binding FrequencyChannelOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                                <TextBlock>
                                                    <Run Text="{Binding ChannelIndex, Mode=OneWay}" />
                                                    <Run Text=" - " />
                                                    <Run Text="{Binding FrequencyDisplay, Mode=OneWay}" />
                                                    <Run Text=" MHz" Foreground="Gray" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorderStyle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}">
                                <TextBlock Text="LOW DUTY CYCLE" Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>
                            <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Enable" IsChecked="{Binding LowDutyCycleEnabled}" IsEnabled="{Binding ImpinjExtensionsAvailable}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Empty Field Timeout (ms):" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmptyFieldTimeoutMs}" IsEnabled="{Binding ImpinjExtensionsAvailable}" Style="{StaticResource FieldControlStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Field Ping Interval (ms):" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FieldPingIntervalMs}" IsEnabled="{Binding ImpinjExtensionsAvailable}" Style="{StaticResource FieldControlStyle}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Diagnostics">

<mah:MetroWindow x:Class="LlrpReaderStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:vm="clr-namespace:LlrpReaderStudio.ViewModels"
        xmlns:views="clr-namespace:LlrpReaderStudio.Views"
        Title="LLRP Reader Studio" Height="780" Width="1240"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FlatCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatMiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View-ViewModel DataTemplates -->
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AddDataSourceViewModel}">
            <views:AddDataSourceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DataSourceSettingsViewModel}">
            <views:DataSourceSettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TagMemoryViewModel}">
            <views:TagMemoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,12">
                <StackPanel DockPanel.Dock="Top">
                    <!-- Brand Header Card -->
                    <Border Padding="16,14" Margin="12,0,12,20" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LLRP" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                            <TextBlock Text="READER STUDIO" FontSize="11" FontWeight="Bold" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- SHOWCASES Navigation -->
                    <TextBlock Text="SHOWCASES" FontSize="11" FontWeight="Bold" Margin="16,0,0,8" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Inventory" Margin="12,2" Padding="12,8" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="#" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="寻卡 / Inventory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="TagMemory" Margin="12,2" Padding="12,8" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="M" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Tag Memory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- DATA SOURCES -->
                    <DockPanel Margin="16,24,16,8">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="AddDataSource" DockPanel.Dock="Right" FontWeight="Bold" ToolTip="Add Data Source" Style="{StaticResource FlatCircleButtonStyle}">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Text="DATA SOURCES" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Data Source Readers List -->
                    <Grid Margin="12,0">
                        <ListBox ItemsSource="{Binding Readers}"
                                 SelectedItem="{Binding SelectedReader}"
                                 BorderThickness="0"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="2"
                                                        Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReaderItemViewModel}">
                                    <Border Padding="4,3" MinHeight="38">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <mah:ToggleSwitch Grid.Column="0"
                                                              IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                              OnContent=""
                                                              OffContent=""
                                                              ToolTip="Enable/Disable reader for operations"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"
                                                              Margin="0,0,8,0" />

                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.OpenDataSourceSettingsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="0"
                                                    Margin="0,0,6,0"
                                                    MinHeight="28">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Endpoint}" FontSize="10" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Column="2" Command="{Binding DeleteCommand}" ToolTip="Remove data source" VerticalAlignment="Center" Style="{StaticResource FlatMiniButtonStyle}">
                                                <TextBlock Text="×" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- SETTINGS Navigation -->
                    <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold" Margin="16,24,0,8" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="12,2" Padding="12,8" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="S" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Software Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="About" Margin="12,2" Padding="12,8" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="i" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="About Studio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Dynamic Content Area -->
        <Grid Grid.Row="0" Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Continuous Mode - Runs Forever" FontSize="12" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Unique Tags: " FontSize="12" />
                    <TextBlock Text="{Binding InventoryVM.UniqueTagCount}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="  |  Read Rate: " FontSize="12" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding InventoryVM.ReadRateText}" FontSize="12" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>

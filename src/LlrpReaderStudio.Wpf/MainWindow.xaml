<mah:MetroWindow x:Class="LlrpReaderStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:vm="clr-namespace:LlrpReaderStudio.ViewModels"
        xmlns:views="clr-namespace:LlrpReaderStudio.Views"
        Title="LLRP Reader Studio" Height="780" Width="1240"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        Background="#0F172A">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- View-ViewModel DataTemplates -->
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AddDataSourceViewModel}">
            <views:AddDataSourceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TagMemoryViewModel}">
            <views:TagMemoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid Background="#0F172A" MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Row="0" Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16,0,12">
                <StackPanel DockPanel.Dock="Top">
                    <!-- Brand Header Card -->
                    <Border Background="#0F172A" Padding="16,14" Margin="12,0,12,20" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="LLRP" Foreground="#F59E0B" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="READER STUDIO" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- SHOWCASES Navigation -->
                    <TextBlock Text="SHOWCASES" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="16,0,0,8" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Inventory" Margin="12,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTabName}" Value="Inventory">
                                        <Setter Property="Background" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="#" Foreground="#10B981" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="寻卡 / Inventory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="TagMemory" Margin="12,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTabName}" Value="TagMemory">
                                        <Setter Property="Background" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="M" Foreground="#F97316" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Tag Memory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- DATA SOURCES -->
                    <DockPanel Margin="16,24,16,8">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="AddDataSource" DockPanel.Dock="Right" Foreground="#38BDF8" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="18" ToolTip="Add Data Source" Cursor="Hand">
                            <TextBlock Text="+" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Text="DATA SOURCES" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Data Source Readers List -->
                    <Grid Margin="12,0">
                        <ListBox ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}" Background="Transparent" BorderThickness="0" MaxHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ReaderItemViewModel}">
                                    <Border Background="#0F172A" Padding="10,8" Margin="0,3" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Endpoint}" Foreground="#38BDF8" FontSize="11" />
                                                <TextBlock Text="{Binding State, StringFormat=LLRP · {0}}" Foreground="#94A3B8" FontSize="10" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Width="38" Height="22" Padding="1" FontSize="10" FontWeight="Bold" ToolTip="Enable/Disable reader for inventory" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Content" Value="ON" />
                                                        <Setter Property="Background" Value="#10B981" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="BorderBrush" Value="#059669" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter Property="Content" Value="OFF" />
                                                                <Setter Property="Background" Value="#475569" />
                                                                <Setter Property="BorderBrush" Value="#334155" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ToggleButton.Style>
                                            </ToggleButton>
                                            <Button Grid.Column="3" Command="{Binding DeleteCommand}" Foreground="#EF4444" Background="Transparent" BorderThickness="0" ToolTip="Delete data source" VerticalAlignment="Center" Width="24" Height="24" Padding="0" Cursor="Hand">
                                                <TextBlock Text="x" Foreground="#EF4444" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- SETTINGS Navigation -->
                    <TextBlock Text="SETTINGS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="16,24,0,8" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" Margin="12,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTabName}" Value="Settings">
                                        <Setter Property="Background" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="S" Foreground="#8B5CF6" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Tag Logging &amp; Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="About" Margin="12,2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTabName}" Value="About">
                                        <Setter Property="Background" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="i" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" Width="18" Margin="0,0,10,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="About Studio" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Dynamic Content Area -->
        <Grid Grid.Row="0" Grid.Column="1" Background="#0F172A">
            <ContentControl Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Continuous Mode - Runs Forever" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Unique Tags: " Foreground="#94A3B8" FontSize="12" />
                    <TextBlock Text="{Binding InventoryVM.UniqueTagCount}" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="  |  Read Rate: " Foreground="#94A3B8" FontSize="12" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding InventoryVM.ReadRateText}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
